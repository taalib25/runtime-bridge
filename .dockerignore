# More info: https://docs.docker.com/engine/reference/builder/#dockerignore-file
# Ignore everything by default and re-include only needed files
**

# Re-include Go source files (but not *_test.go)
!**/*.go
**/*_test.go

# Re-include Go module files
!go.mod
!go.sum

# Re-include Helm charts (baked into image)
# hermes-agent is the active runtime (BRIDGE_CHART_PATH=/charts/hermes-agent);
# runtime-node-core is kept for rollback. Both are COPYed in the Dockerfile.
!charts/hermes-agent
!charts/hermes-agent/**
!charts/runtime-node-core
!charts/runtime-node-core/**
